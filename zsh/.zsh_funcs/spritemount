spritemount() {
  local sprite_name="$1"
  local mount_point="/tmp/sprite-mount"
  mkdir -p "$mount_point"
  sshfs -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3 \
    -o ProxyCommand="sprite proxy -s %h -W 22" "sprite@$sprite_name:" \
    "$mount_point"
  cd "$mount_point" || return 1
}
